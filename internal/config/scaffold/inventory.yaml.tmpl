# The nodes of the site: their attributes, where they stand and how they are
# reached.
# yaml-language-server: $schema={{schema "NodeInventory"}}
apiVersion: clusterctl/v1alpha1
kind: NodeInventory
metadata:
  name: {{yaml .Site}}
spec:
  # One entry per node set. A later entry refines an earlier one for the
  # nodes they share, so the general entries come first:
  #
  #   - nodes: node[001-064]
  #     attributes: {class: compute}
  #   - nodes: node[001-032]
  #     rack: R01
  #   - nodes: node[033-064]
  #     rack: R02
  nodes: []
