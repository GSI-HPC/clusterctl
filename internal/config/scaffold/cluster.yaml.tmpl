# What differs between the clusters of a site. Each cluster has a document of
# its own, and a context in the Config document that acts on it.
# yaml-language-server: $schema={{schema "Cluster"}}
apiVersion: clusterctl/v1alpha1
kind: Cluster
metadata:
  name: {{yaml .Cluster}}
spec:
  site: {{yaml .Site}}
  # The NodeInventory documents that hold this cluster's nodes. Without this
  # list the cluster takes every inventory that is loaded, and it is refused
  # once another site is read with this one.
  inventories:
    - {{yaml .Site}}

  slurm:
    # The host role the Slurm clients run on.
    role: login

  groups:
    # One group per value of the class attribute of the node inventory, so
    # that @compute names every node whose class is compute.
    defaultSource: inventory
    sources:
      inventory:
        attribute: class
