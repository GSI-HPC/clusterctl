# script exits on the first unset variable encountered
set -u    # nounset
# script stops on first command failure
set -e    # errexit
# ensures that if any command in a set of piped commands failed, the overall
# exit status is the status of the failed command
set -o pipefail

VERSION=0.4

# Filename of this script
SCRIPT=${0##*/}


# Help text for this script
HELP=\
"Usage: $SCRIPT [-h] [--version] [arg]

This script use cluster-login to access a compute cluster and run
commands again the Slurm user interface, processes the output and
aggregates the information.

Positional arguments:

  add <account> [<organisation>] [<description>]

    Add a new account to the accounting database. Organisation will 
    be \$CLUSTER_SLURM_ORG (or 'default') and the description will be
    the account name unless specified otherwise.

  coordinator <account> <coordinator>[,<coordinator>,...]

    Set coordinators for a given account.

  limits <account>

    List all users assoicated to an account with maximum limits for:
    MaxSubmit MaxJobs MaxNodes MaxCPUs MaxCPUMins MaxWall

  list [<account>]

    List all account with their coordinators. Optionally one argument
    naming the account is supported to limit the output.

  shares [<account>] [<fairshare>]

    List all accounts fair-share statistics. Optionally add an account
    name as argument to limit the output. Passing an account name and
    fair-share value as argument will modify the accounting configuration
    accordingly.

  users <account>

    List all user for a specified account.
  

Optional arguments:
  -d, --debug                          Enable verbose output
  -h, --help                           Show this help message
  --version                            Program version number"

_DEBUG=${_DEBUG:-false}
function _debug() {
        if [ "$_DEBUG" = "true" ]; then
                echo 1>&2 "$SCRIPT debug -- $@"
        fi
}

function _error() {
        echo 1>&2 "Error: $@"
	exit 1
}

# check dependency programs
for cmd in \
        column \
        nodeset \
        cluster-login
do
        command -v $cmd &>/dev/null || _error "$cmd program missing"
done

# Parse the command line options
ARGS=$(getopt -o dh -l "debug,help,version" -- "$@")
eval set -- "$ARGS"
while true; do
        case "$1" in
        -d|--debug)
                export _DEBUG=true
                shift
                ;;
        -h|--help)
                echo "$HELP"
                exit 0
                ;;
        --version)
                echo $VERSION
                exit 0
                ;;
        --)
                shift
                break 
                ;;
        *) 
                break 
                ;;
        esac
done

##
# Add a new account
#
add() {
        if [ "$#" -eq 1 ]
        then
                local name=$1
		local org=${2:-${CLUSTER_SLURM_ORG:-default}}
                local text=${3:-$name}
                local command="sacctmgr add account $name description='$text' organization=$org"
                cluster-login -- "$command"
        else
                _error "Requires and account name as argument!"
        fi
}

##
# Set the account coordinators
# 
coordinator() {
        if [ "$#" -eq 2 ]
        then
                local account=$1
                local coordinators=$2
                local command="sacctmgr add coordinator account=$account names=$coordinators"
                cluster-login -- "$command"
        else
                _error "Requires and account name and coordinator name as arguments"
        fi
}

limits() {
        if [ "$#" -eq 1 ]
        then
                local account=$1
                local format="Account,User,MaxSubmit,MaxJobs,MaxNodes,MaxCPUs,MaxCPUMins,MaxWall"
                local options="--noheader --parsable2 --associations"
                local command="sacctmgr $options list account where name=$account format=$format"
                cluster-login -- "$command" \
                        | tail -n+2 \
                        | column --separator='|' --table --table-columns=$format
        else
                _error "Requires and account name to show limits"
        fi
}

list() {
        local format="Account,Coordinator"
        local command="sacctmgr --noheader --parsable2 list account withcoordinator format=$format"
        # if one argument is present
        if [ "$#" -eq 1 ] ; then
                # show a specified account
                command="$command where account=$1"
        fi
        cluster-login -- "$command" \
                | column --separator='|' --table --table-columns=$format
}

##
# Fair-share statistics. Optional argument to limit output to a single account.
#
shares() {
        local format="Account,User,RawShares,NormShares,RawUsage,NormUsage,EffectvUsage,FairShare"
        local command="sshare --all --format=$format"
        # if one argument is present
        if [ "$#" -eq 1 ]
        then
                # show a specified account
                command="$command --account=$1"
        elif [ "$#" -eq 2 ]
        then
                local account=$1
                local fairshare=$2
                command="sacctmgr modify account name=$account set fairshare=$fairshare"
        fi
        cluster-login -- "$command"
}

users() {
        if [ "$#" -eq 1 ]
        then
                local account=$1
                local command="sacctmgr --noheader --parsable2 list account withassoc where name=$account format=account,user"
                cluster-login -- "$command" \
                        | tail -n+2 \
                        | column --separator='|' --table --table-columns "Account,User"
        else
                _error "Requires and account name to show users"
        fi
}


# use a default sub-command unless specified
_command="${1:-help}"
test "$#" -eq 0 || shift
# evaluate sub-commands
case "$_command" in
        add)
                add $@
                ;;
        coord|coordinator)
                coordinator $@
                ;;
        limits)
                limits $@
                ;;
        list)
                list $@
                ;;
        users)
                users $@
                ;;
        shares)
                shares "$@"
                ;;
        *)
                echo "$HELP" 
                exit 1
                ;;
esac

exit 0


