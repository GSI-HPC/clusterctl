# ensures that if any command in a set of piped commands failed, the overall
# exit status is the status of the failed command
set -o pipefail

VERSION=0.84

# Filename of this script
SCRIPT=${0##*/}


##
# Help text for this script
#
HELP=\
"usage: $SCRIPT [<options>] <command>

Connect with service modules within the management network

Command arguments:

  bmc-name <nodeset>
    Service module name for a node

  bmc-ip <node>
    Service module IP address for a node. Use the verbose option
    to print the BMC name in addition.

  bmc-ping <nodeset>
    Ping a list for service modules

  bmc-web, web <node>
    Connect with an IPMI web-interface
 
  bmc-wget, wget <node>
    Send an HTTP request to the BMC

  chassis [cycle|off|on|reset|status]
    Iterates over the list of nodes using ipmitool.
    Reads CLUSTER_NODES or requires option --nodeset to specify
    a nodeset to work with. Defaults to the status subcommand.

  power  [cycle|off|on|reset|status]
    Iterates over the list of nodes using ipmipower.
    Reads CLUSTER_NODES or requires option --nodeset to specify
    a nodeset to work with. Defaults to the status subcommand.

  pdu <row> <rack> [<command>]
    Connect to a rack PDU using SSH, or run a command on it. The PDU
    host name is CLUSTER_PDU_NAME_FORMAT filled in with row and rack.

Optional arguments:

  -d, --debug             Enable verbose output
  -h, --help              Show this help message
  -n, --nodeset <nodes>   Specify a nodeset
  -N, --no-vpn-check      Disable check for an online VPN connection
  -T                      Print a timer stamp '%Z %Y/%m/%d %H:%M'
  -v, --verbose           Print additional information
  --version               Program version number

Environment variables:

  BMC_USER                User name for the BMC
  BMC_PASSWORD            Password for the BMC user
  CLUSTER_IPMI_DOMAIN     Sub-domain for BMCs (required via config or env)
  CLUSTER_NODES           Define a nodeset to work with
  CLUSTER_PDU_NAME_FORMAT printf format of PDU host names, e.g. pdu%s-%s
  CLUSTER_VPN_CHECK       Set true to enable the check for an online VPN connection
  CLUSTER_VPN_COMMAND     Command checking the VPN connection, required by the check"

##
# Print debug output if _DEBUG=true
#
_debug() {
        if [ "$_DEBUG" = "true" ]; then
                echo 1>&2 "$SCRIPT debug -- $@"
        fi
}

##
# Print an error message and exit the program
#
_error() {
        echo 1>&2 "$SCRIPT error -- $@"
	exit 1
}

_error_cluster_nodes() {
        _error "Set the environment variable CLUSTER_NODES or use command-line option -n/--nodeset!"
}

_error_bmc_password() {
        _error "Set the environment variable BMC_PASSWORD for the $BMC_USER!"
}


##
# Complete the naming convention for the BMCs from a node name
#
bmc-name() {
        cluster-node-fqdn --bmc "${1:?Node name argrument required}"
}

##
# Resolve the IP-address of a BMC
#
bmc-ip() {
        local nodes=${1:?Nodeset argument required}
        local bmcs=$(bmc-name $nodes)
        local node=
        # iterate over all nodes
        for node in $(nodeset -e $bmcs)
        do
                if host $node >/dev/null
                then
                        if [ "$verbose" = "true" ]
                        then
                                host $node | cut -d' ' -f1,4
                        else
                                host $node | cut -d' ' -f4
                        fi
                else
                        _error "$node has no DNS response"
                fi
        done
}

##
# Ping a nodeset of BMC IP addresses...
#
bmc-ping() {
        local nodes=${1:?Nodeset argument required}
        local bmcs=$(bmc-name $nodes)
        local ips=
        local node=
        # iterate over all nodes
        for node in $(nodeset -e $bmcs)
        do
                # query DNS for the IP address
                response=$(host $node)
                # if we get a valid response
                if [ $? -eq 0 ]
                then
                        # append the IP to a list
                        ips="$ips $(echo $response | tr -s ' ' | cut -d' ' -f4)"
                # alert the user about a missing IP address resolution
                else
                        echo "error: $node address missing"
                fi
        done
        # if we found IP adresses to ping...
        if [ -n "$ips" ]
        then
                # login to the management network an ping all BMCs
                cluster-login -ri "fping $ips 2>/dev/null | ip2host"
        fi
}

pdu() {
        local row=${1:?Specify the rack row}
        shift
        local rack=${1:?Specify the rack}
        shift
        local pdu_host
        pdu_host=$(printf "${CLUSTER_PDU_NAME_FORMAT:-pdu%s-%s}" "$row" "$rack")${domain:+.$domain}
        _debug "PDU host: $pdu_host"

        if [ "$#" -eq 0 ]
        # login to the PDU service module
        then
		ssh admin@$pdu_host
	# Execute given command on the PDU service module
	else
		ssh admin@$pdu_host -C "$@"
        fi
}

##
# Use ipmipower for power management of nodes
#
ipmi_power() {
        # enforce cluster nodes
        [ -n "$cluster_nodes" ] || _error_cluster_nodes

        cluster_nodes=$(bmc-name $cluster_nodes)
        _debug "Nodeset for the BMCs: $cluster_nodes"
        
        # enforce a BMC password
        [ -n "$bmc_password" ] || _error_bmc_password

        # query the power status by default unless overwritten by the user
        local command=${1:-status}
        case "$command" in
        cycle|c)
                command='--cycle'
                ;;
        off|f)
                command='--off'
                ;;
        on|o)
                command='--on'
                ;;
        reset|r)
                command='--reset'
                ;;
        status|s)
                command='--stat'
                ;;
        *)
                echo "Command $command not supported"
                return 1
                ;;
        esac
        
        # run following command on the management gateway
        cluster-login --root --mgmt "
                /usr/sbin/ipmipower -D LAN_2_0 \
                        --username=$bmc_user \
                        --password='$bmc_password' \
                        --hostname=$cluster_nodes \
                        $command
        "
}

##
# Use ipmitool for power management of nodes
#
chassis() {

        # enforce cluster nodes
        [ -n "$cluster_nodes" ] || _error_cluster_nodes

        # expand the cluster nodes for later iteration
        cluster_nodes=$(nodeset -e $cluster_nodes)
        _debug "Nodeset: $cluster_nodes"

        # enforce a BMC password
        [ -n "$bmc_password" ] || _error_bmc_password

        # query the power status by default unless overwritten by the user
        local command=${1:-status}
        case "$command" in
                # subcommands supported by ipmitool
                cycle|off|on|reset|status)

                        # iterate over the list of cluster nodes
                        for node in $cluster_nodes
                        do
                                # run the command on the management gateway
                                cluster-login --root --mgmt "
                                        echo -n \"$node: \";
                                        /usr/bin/ipmitool \
                                                -I lanplus \
                                                -R 1 \
                                                -U $bmc_user \
                                                -P '$bmc_password' \
                                                -H $(bmc-name $node) \
                                                chassis power $command 2>&1
                                "
                        done

                        ;;

                *)
                        _error "Command '$command' not supported"
                        ;;
        esac
}

##
# Open the web-interface of BMC service module
#
web() {
        # check if a command-line argument is present
        if ! [ $# -eq 1 ]
        then
                _error "Node name argument required"
        else
                # node name provided by the user
                local node_name=$1
                # resolve the IP address of the service module
                local bmc_ip=$(bmc-ip $node_name)
                # check for the service module IP address
                if ! [ $? -eq 0 ]
                then
                        _error "Could not find IP address of the BMC for $node_name"
                else
                        $BROWSER http://$bmc_ip >/dev/null &
                fi
        fi
}


##
# Try to make an HTTP request to the BMC
#
wget() {
        # check if a command-line argument is present
        if ! [ $# -eq 1 ]
        then
                _error "Node name argument required"
        else
                # node name provided by the user
                local node_name=$1
                # resolve the IP address of the service module
                local bmc_ip=$(bmc-ip $node_name)
                # check for the service module IP address
                if ! [ $? -eq 0 ]
                then
                        _error "Could not find IP address of the BMC for $node_name"
                else
                        echo -n "$node_name: "
                        /usr/bin/wget --no-check-certificate -t 1 -T 1 -o /dev/null http://$bmc_ip 
                        case $? in
                                0) echo No problems occurred ;;
                                1) echo Generic error code ;;
                                2) echo Parse error ;;
                                3) echo File I/O error ;;
                                4) echo Network failure ;;
                                7) echo Protocol errors ;;
                                *) echo error code $? ;; 
                        esac
                fi
        fi
}

##
# Default Variables
#
network=${CLUSTER_NET_IPMI:-}
domain=${CLUSTER_DOMAIN_INFRA:-}
ipmi_domain=${CLUSTER_IPMI_DOMAIN:-}}
verbose=false

##
# Read environment variables
#

# check if debugging is enabled
_DEBUG=${_DEBUG:-false}
# read the BMC service module configuration
bmc_user=${BMC_USER:-${CLUSTER_BMC_USER:-admin}}
bmc_password=$BMC_PASSWORD
# read a nodeset if defined
cluster_nodes=$CLUSTER_NODES
# check if a VPN connection is online
cluster_vpn_check=${CLUSTER_VPN_CHECK:-false}
cluster_vpn_command=${CLUSTER_VPN_COMMAND:-}

##
# Parse the command line options
#
ARGS=$(getopt -o dhn:NTv -l "debug,help,nodeset:,no-vpn-check,verbose,version" -- "$@")
eval set -- "$ARGS"
while true; do
        case "$1" in
        -d|--debug)
                shift
                export _DEBUG=true
                ;;
        -h|--help)
                echo "$HELP"
                exit 0
                ;;
        -n|--nodeset)
                shift
                cluster_nodes=$1
                shift
                ;;
        -N|--no-vpn-check)
                shift
                cluster_vpn_check=false
                ;;
        -T)
                shift
                date '+%Z %Y/%m/%d %H:%M'
                ;;
        -v|--verbose)
                shift
                verbose=true
                ;;
        --version)
                echo $VERSION
                exit 0
                ;;
        --)
                shift
                break 
                ;;
        *) 
                break 
                ;;
        esac
done

##
# Check dependency programs
#
for cmd in \
        cluster-login \
        cluster-node-fqdn \
        nodeset \
        host
do
        command -v $cmd &>/dev/null || _error "$cmd program missing"
done

##
# Check for the VPN connection to the cluster
#
if $cluster_vpn_check
then
        [ -n "$cluster_vpn_command" ] || _error "Set CLUSTER_VPN_COMMAND to check the VPN connection"
        if ! eval "$cluster_vpn_command" >/dev/null
        then
                eval "$cluster_vpn_command"
                exit 1
        fi
else
        _debug "Cluster VPN connection check disabled"
fi



##
# Read the command-line arguments
#
_command=$1 ; shift
case "$_command" in
        bmc-name|bc)
                bmc-name "$@"
                ;;
        bmc-ip|bi)
                bmc-ip "$@"
                ;;
	bmc-web|web|w)
                web "$@"
                ;;
        bmc-wget|wget)
                wget "$@"
                ;;
        bmc-ping|bp)
                bmc-ping $@
                ;;
	chassis|c)
                chassis $@
                ;;
        impipower|power|pw)
                ipmi_power "$@"
                ;;
        pdu)
                pdu "$@"
                ;;
        *)
                _error "Command $_command not supported!"
                ;;
esac

exit 0
