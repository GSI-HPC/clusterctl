# script stops on first command failure
set -e    # errexit
# ensures that if any command in a set of piped commands failed, the overall
# exit status is the status of the failed command
set -o pipefail

VERSION=0.3

# Filename of this script
SCRIPT=${0##*/}

# Help text for this script
HELP=\
"Usage: $SCRIPT [<options>] <command> [<args>]

Check the statue of an InfiniBand network connection
for a given node. This includes port counters of
a corresponding uplink switch port.

Commands:

  state
    Reads CLUSTER_NODES or requires option --nodes to specify
    a nodeset to work with. Resolve a nodes MAC address from the
    DHCP server and calculates the GUID to check the port state. 
    Use option --ping to send a network ping if the port is active.

  counters <node>          print node port counters

  guid <node>              resolve the node GUID

  uplink-guid <node>       resolve GUID of the switch port

  uplink-counter <node>    print switch port counters

Optionals:

  -d, --debug              Enable verbose output
  -h, --help               Show this help message
  -N, --no-vpn-check       Disable check for an online VPN connection
  -p, --ping               Send a ping to a node when checking state
  --version                Program version number

Environment variable:

  CLUSTER_NODES           Define a nodeset to work with"


timestamp() {
        echo -n "$(date +%Y%m%dT%H%M%S) "
}

##
# Print debug output if _DEBUG=true
#
_debug() {
        if [ "$_DEBUG" = "true" ]; then
                echo 1>&2 "$SCRIPT debug -- $@"
        fi
}

##
# Print an error message and exit the program
#
_error() {
        echo 1>&2 "$SCRIPT error -- $@"
	exit 1
}

_error_cluster_nodes() {
        _error "Set the environment variable CLUSTER_NODES or use command-line option -n/--nodeset!"
}


##
# Default Variables
#
ADMIN_GATEWAY=${CLUSTER_HOST_MGMT_GATEWAY:-}
DHCP_SERVER=${CLUSTER_HOST_IB_GATEWAY:-}
GATEWAY=${CLUSTER_HOST_POOL:-}
LOGIN=${CLUSTER_HOST_LOGIN:-}

##
# Read environment variables
#
# read a nodeset if defined
cluster_nodes=$CLUSTER_NODES
state_ping=false

# Parse the command line options
ARGS=$(getopt -o dhn:p -l "debug,help,nodeset:,ping,version" -- "$@")
eval set -- "$ARGS"
while true; do
        case "$1" in
        -d|--debug)
                export _DEBUG=true
                shift
                ;;
        -h|--help)
                echo "$HELP"
                exit 0
                ;;
        -n|--nodeset)
                shift
                cluster_nodes=$1
                shift
                ;;
        -p|--ping)
                shift
                state_ping=true
                ;;
        --version)
                echo $VERSION
                exit 0
                ;;
        --)
                shift
                break 
                ;;
        *) 
                break 
                ;;
        esac
done

# check dependency programs
for cmd in \
        cluster-login \
        cluster-dhcp \
        nodeset
do
        command -v $cmd &>/dev/null || _error "$cmd program missing"
done

##
# Read the DHCP configuration from the DHCP server
#
dhcp-config() {
        local node_name=${1:?Requires node name as argument}
        cluster-dhcp mac-address $node_name | cut -d= -f2
}

##
# Get a nodes MAC-address and map it to the InfiniBand GUID
#
mac2guid() {
        local node=${1:?Requires node name as argument}
        # query DHCP to resolve a MAC address...
        local dhcp=$(dhcp-config $node | tr '\n' ' ')
        if [ -z "$dhcp" ]
        then
                _error "$node MAC-address missing in DHCP"
        fi
        # a node may have multiple MAC addresses...
        for mac in $dhcp
        do
                # ...construct the InfiniBand GUID
                local prefix=$(echo $mac | cut -d: -f1-3 | tr -d ':')
                local suffix=$(echo $mac | cut -d: -f4-6 | tr -d ':')
                guid="0x${prefix}0300${suffix}"
                _debug "$node MAC address $mac HCA GUID $guid"
                echo "$guid"
        done
}

##
# Get the InfiniBand link state for a node, and send a ping if the link
# is active
#
state() {
        # enforce cluster nodes
        [ -n "$cluster_nodes" ] || _error_cluster_nodes
        # iterate over all nodes in list
        for node in $(nodeset -e $cluster_nodes)
        do
                # iterate over all GUIDs for each node
                for guid in $(mac2guid $node)
                do
                        result="$node dhcp_guid=$guid"

                        # Check the port state of a given GUID
                        if cluster-login --root -- "ibportstate -G $guid query 2>/dev/null" 1>/dev/null
                        then
                                result="$result port=active"
                                # check if user requested to send a ping
                                if $state_ping
                                then
                                        # send a single ping to the node
                                        if cluster-login -- ping -c 1 -w 1 -q $node >/dev/null 2>/dev/null
                                        then
                                                result="$result ping=true"
                                        else
                                                result="$result ping=false"
                                        fi
                                fi
                        else
                                result="$result port=inactive"
                        fi
                        echo "$result"
                done
        done
}

##
# Get a nodes InfiniBand counters
#
counters() {
        local node=${1:?Requires node name as argument}
        local guid=$(mac2guid $node)
        echo "$node $guid"
        ssh -J $GATEWAY root@$LOGIN -C \
                ibqueryerrors -G $guid --data \
                | grep GUID \
                | cut -d: -f2- \
                | tr ']' "\n" \
                | tr -d '['
}

##
# Get the InfiniBand GUID of the switch a node is uplinked to
#
uplink-guid() {
        local guid=${1:?Requires GUID as argument}
        ssh -q -J $GATEWAY root@$LOGIN -C \
                ibqueryerrors --switch --verbose --data --details --report-port \
                | grep -B1 -i $guid \
                | head -n 1 \
                | sed 's/^[ \t]*//;s/[ \t]*$//' \
                | cut -d' ' -f2
}

##
# Get the InfiniBand counters of a nodes uplink port
#
uplink-counters() {
        local node=${1:?Requires node name as argument}
        local guid=$(mac2guid $node)
        local uplink_guid=$(uplink-guid $guid)
        echo "$node $guid ==> $uplink_guid"
        ssh -J $GATEWAY root@$LOGIN -C \
                ibqueryerrors --switch --data --report-port -G $uplink_guid \
                | grep -B1 -i $guid \
                | grep GUID \
                | cut -d: -f2- \
                | tr ']' "\n" \
                | tr -d '['
}


_command=$1 ; shift
case "$_command" in 
        counters)
                counters ${1:?Requires node name as argument}
                ;;
        guid)
                mac2guid ${1:?Requires node name as argument}
                ;;
        state)
                state
                ;;
        uplink-guid)
                uplink-guid $(mac2guid ${1:?Requires node name as argument})
                ;;
        uplink-counters)
                uplink-counters ${1:?Requires node name as argument}
                ;;
        *)
                echo "$HELP" 
                ;;
esac

exit 0


