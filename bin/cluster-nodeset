# script exits on the first unset variable encountered
set -u    # nounset
# script stops on first command failure
#set -e    # errexit
# ensures that if any command in a set of piped commands failed, the overall
# exit status is the status of the failed command
set -o pipefail

VERSION=0.14

# Filename of this script
SCRIPT=${0##*/}

# Help text for this script
HELP=\
"Usage: $SCRIPT [<options>] <command> [<args>]

Commands:
 
  loop <command>                Loop over the command replacing {} for each
                                node in the nodeset.
  rm, remove-host-fingerprint   Delete all SSH fingerprints in known_hosts
  ver, verify-host-fingerprint  Replace all SSH fingerprints in known_hosts

Options:

  -d, --debug             Enable debug output
  -h, --help              Show this help message
  -n, --nodes <nodeset>   Specify the nodeset to process on
  --version               Program version number

Environment variables:

  CLUSTER_NODES                  Specify the nodeset to process on
  CLUSTER_KNOWN_HOSTS_FILE       known_hosts file to modify, defaults to
  CLUSTER_LOGIN_SSH_KNOWN_HOSTS  \$CLUSTER_TOOLS_PATH/site-config/ssh-known-hosts"

##
# Help functions
#

_DEBUG=${_DEBUG:-false}
function _debug() {
        if [ "$_DEBUG" = "true" ]; then
                echo 1>&2 "$SCRIPT debug -- $@"
        fi
}

function _error() {
        echo 1>&2 "$SCRIPT error: $@"
	exit 1
}

##
# Convert node short name to FQDN, names matching no node prefix default to
# the HPC domain like in cluster-knownhosts
#
node_to_fqdn() {
        local node
        node=$(cluster-node-fqdn "$1") || return
        if [[ "$node" != *.* ]]
        then
                node=$node.${CLUSTER_DOMAIN_HPC:-}
        fi
        echo "$node"
}

##
# Sort the host keys in the known_hosts file, keep comments on top
#
sort_known_hosts() {
        local sorted
        sorted=$(grep '^#' "$known_hosts_file"; grep -v -e '^#' -e '^$' "$known_hosts_file" | sort)
        [ -n "$sorted" ] && printf '%s\n' "$sorted" > "$known_hosts_file"
}

##
# Remove SSH host fingerprints for a nodeset
#
remove_ssh_fingerprints() {
        for node in $(nodeset -e $cluster_nodes)
        do
                node=$(node_to_fqdn $node)
                ssh-keygen -f "$known_hosts_file" -R $node 2>/dev/null
                ssh-keygen -f "$known_hosts_file" -R $(echo $node | cut -d. -f1) 2>/dev/null
                ssh-keygen -f "$known_hosts_file" -R $(host $node | cut -d' ' -f4) 2>/dev/null
        done
}

##
# Loop a command over a set of nodes
# 
nodeset-loop() {
        # iterate over the nodeset
        for node in $(nodeset -e $cluster_nodes)
        do
                # replace {} with the node name
                local command=$(echo "$@" | sed "s/{}/$node/g")
                _debug "Running command: $command"
                # run the command
                eval $command
        done
}

##
# Update the SSH fingerprints for a nodeset
#
nodeset-host-verification() {
        # remove old fingerprints
        remove_ssh_fingerprints
        # add new fingerprints
        for node in $(nodeset -e $cluster_nodes)
        do
                node=$(node_to_fqdn $node)
                echo Updating $node
                ssh-keyscan -q -t ed25519 $node >> "$known_hosts_file"
        done
        sort_known_hosts
}

##
# Read environment variables, and set defaults
#

cluster_nodes=${CLUSTER_NODES:-''}
known_hosts_file=${CLUSTER_KNOWN_HOSTS_FILE:-${CLUSTER_LOGIN_SSH_KNOWN_HOSTS:-$CLUSTER_TOOLS_PATH/site-config/ssh-known-hosts}}
# check if a VPN connection is online
cluster_vpn_check=${CLUSTER_VPN_CHECK:-false}


# Parse the command line options
ARGS=$(getopt -o dhn:N -l "debug,help,nodes:,no-vpn-check,version" -- "$@")
eval set -- "$ARGS"
while true; do
        case "$1" in
        -d|--debug)
                shift
                export _DEBUG=true
                ;;
        -h|--help)
                echo "$HELP"
                exit 0
                ;;
        -n|--nodes)
                shift
                cluster_nodes=$1
                shift
                ;;
        -N|--no-vpn-check)
                shift
                cluster_vpn_check=false
                ;;
        --version)
                echo $VERSION
                exit 0
                ;;
        --)
                shift
                break 
                ;;
        *) 
                break 
                ;;
        esac
done


##
# Check dependency programs
#
for cmd in \
        cluster-node-fqdn \
        nodeset \
        ssh-keygen \
        ssh-keyscan \
        host
do
        command -v $cmd &>/dev/null || _error "$cmd program missing"
done

# check if a nodeset for processing is available
if ! [ -n "$cluster_nodes" ]
then
        _error "Nodeset required! Use option -n or the CLUSTER_NODES environment variable..."
fi
_debug "Using nodeset: $cluster_nodes"
_debug "Using known_hosts file: $known_hosts_file"


##
# Run the command argument
#
command=${1:-'loop'}
[ $# -gt 0 ] && shift

case "$command" in
        loop)
                nodeset-loop "$@"
                ;;
        rm|remove-host-fingerprint|remove-ssh-fingerprint)
                remove_ssh_fingerprints
                ;;
        ver|verify-host-fingerprint|verify-ssh-fingerprint)
                nodeset-host-verification
                ;;
        *)
                _error "Command $command not supported"
                ;;
esac



exit 0
