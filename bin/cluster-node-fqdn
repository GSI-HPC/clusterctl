set -u    # nounset
# ensures that if any command in a set of piped commands failed, the overall
# exit status is the status of the failed command
set -o pipefail

VERSION=0.1

# Filename of this script
SCRIPT=${0##*/}

# Help text for this script
HELP=\
"usage: $SCRIPT [-bdh] [--version] <nodeset> [<nodeset> ...]

Print a folded nodeset of fully qualified host names. The prefix of a short
node name selects its domain, names including a domain are kept as they are,
short names matching no prefix are kept as well.

optional arguments:
  -b, --bmc            print the host names of the node BMCs instead
  -d, --debug          enable verbose output
  -h, --help           show this help message
  --version            program version number

Environment variables:

  CLUSTER_NODE_PREFIXES_HPC   Space separated name prefixes of nodes in
                              \$CLUSTER_DOMAIN_HPC, their BMCs are named
                              <node>.\$CLUSTER_DOMAIN_MGMT_HPC
  CLUSTER_NODE_PREFIXES_SITE  Space separated name prefixes of nodes in
                              \$CLUSTER_DOMAIN_SITE, their BMCs are named
                              \$CLUSTER_BMC_PREFIX<node>.\$CLUSTER_DOMAIN_MGMT
  CLUSTER_BMC_PREFIX          Prefix of BMC host names, other nodes get
                              their BMC named \$CLUSTER_BMC_PREFIX<name>"

_DEBUG=${_DEBUG:-false}
_debug() {
        if [ "$_DEBUG" = "true" ]; then
                echo 1>&2 "Debug: $@"
        fi
}

_error() {
        echo 1>&2 "Error: $@"
	exit 1
}

##
# Set _class to hpc, site or other depending on the node name prefix
#
_class=
_node_class() {
        local node=$1 prefix
        for prefix in ${CLUSTER_NODE_PREFIXES_HPC:-}
        do
                if [[ "$node" == "$prefix"* ]]
                then
                        _class=hpc
                        return
                fi
        done
        for prefix in ${CLUSTER_NODE_PREFIXES_SITE:-}
        do
                if [[ "$node" == "$prefix"* ]]
                then
                        _class=site
                        return
                fi
        done
        _class=other
}

##
# Append a domain to a name unless the domain is empty
#
_join() {
        echo "$1${2:+.$2}"
}

node_fqdn() {
        local node=$1
        if [[ "$node" == *.* ]]
        then
                echo "$node"
                return
        fi
        _node_class "$node"
        case "$_class" in
                hpc)  _join "$node" "${CLUSTER_DOMAIN_HPC:-}" ;;
                site) _join "$node" "${CLUSTER_DOMAIN_SITE:-}" ;;
                *)    echo "$node" ;;
        esac
}

bmc_fqdn() {
        local name=$1
        # trim a domain suffix
        local node=${name%%.*}
        _node_class "$node"
        case "$_class" in
                hpc)  _join "$node" "${CLUSTER_DOMAIN_MGMT_HPC:-}" ;;
                site) _join "${CLUSTER_BMC_PREFIX:-}$node" "${CLUSTER_DOMAIN_MGMT:-}" ;;
                *)
                        _debug "$node matches no node prefix, keeping the name"
                        echo "${CLUSTER_BMC_PREFIX:-}$name"
                        ;;
        esac
}

bmc=false
# Parse the command line options
ARGS=$(getopt -o bdh -l "bmc,debug,help,version" -- "$@")
eval set -- "$ARGS"
while true; do
        case "$1" in
        -b|--bmc)
                bmc=true
                shift
                ;;
        -d|--debug)
                _DEBUG=true
                shift
                ;;
        -h|--help)
                echo "$HELP"
                exit 0
                ;;
        --version)
                echo $VERSION
                exit 0
                ;;
        --)
                shift
                break
                ;;
        *)
                break
                ;;
        esac
done

# check dependencies...
for cmd in \
        nodeset
do
        command -v $cmd &>/dev/null || _error "$cmd command not in \$PATH"
done

(( $# >= 1 )) || _error "Requires a nodeset argument!"

names=()
for node in $(nodeset -e "$@")
do
        if $bmc
        then
                names+=("$(bmc_fqdn "$node")")
        else
                names+=("$(node_fqdn "$node")")
        fi
done
_debug "Names: ${names[*]}"
nodeset -f "${names[@]}"
