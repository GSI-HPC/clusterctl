#
# Schedule a reboot and send a warning email to all logged in users.
#

VERSION=0.1

#
# Reject further login from all users other than root:
#
touch /etc/nologin

#
# Schedule reboot:
#
/usr/sbin/shutdown -r +60

#
# Send the warning email:
#
USERS=$(who | cut -f 1 -d ' ' | sort | uniq | grep -v root)
HOSTNAME=`hostname`

for u in $USERS;
do
	/bin/echo "A reboot for maintenance of $HOSTNAME will be performed in one hour from now." | mailx -s "[${CLUSTER_NAME:-Cluster}] Reboot of submit node -> $HOSTNAME" -S smtp=smtp://${CLUSTER_HOST_SMTP:-} -S from="root@$HOSTNAME.${CLUSTER_DOMAIN_SITE:-}" $u@${CLUSTER_DOMAIN_SITE:-}
done
