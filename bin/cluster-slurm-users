# script exits on the first unset variable encountered
set -u    # nounset
# script stops on first command failure
set -e    # errexit
# ensures that if any command in a set of piped commands failed, the overall
# exit status is the status of the failed command
set -o pipefail

VERSION=0.2

# Filename of this script
SCRIPT=${0##*/}


# Help text for this script
HELP=\
"Usage: $SCRIPT [-h] [--version] [arg]

This script use cluster-login to access a compute cluster and run
commands again the Slurm user interface, processes the output and
aggregates the information.

Positional arguments:

  add <user> [<account>] [<default_account>]

    Add a new user association to an existing account. By default user
    become associated to the 'default' account unless specified
    otherwise. The default account is configured similar to the specified
    account unless overwritten with a third argument.

  default <user> <account>

    Configure the default account for a given user.

  list [<user>]

    List all users with their accounts and default. Optionally one
    argument naming a user is supported to limit the output.

Optional arguments:
  -d, --debug                          Enable verbose output
  -h, --help                           Show this help message
  --version                            Program version number"

_DEBUG=${_DEBUG:-false}
function _debug() {
        if [ "$_DEBUG" = "true" ]; then
                echo 1>&2 "$SCRIPT debug -- $@"
        fi
}

function _error() {
        echo 1>&2 "Error: $@"
	exit 1
}

# check dependency programs
for cmd in \
        column \
        nodeset \
        cluster-login
do
        command -v $cmd &>/dev/null || _error "$cmd program missing"
done

# Parse the command line options
ARGS=$(getopt -o dh -l "debug,help,version" -- "$@")
eval set -- "$ARGS"
while true; do
        case "$1" in
        -d|--debug)
                export _DEBUG=true
                shift
                ;;
        -h|--help)
                echo "$HELP"
                exit 0
                ;;
        --version)
                echo $VERSION
                exit 0
                ;;
        --)
                shift
                break 
                ;;
        *) 
                break 
                ;;
        esac
done

add() {
        if [ "$#" -ge 1 ]
        then
                local user=$1                 # user name
                local account=${2:-default}   # associated account
                local default=${3:-$account}  # optional default account
                if cluster-login -- "id $user 2>/dev/null"
                then
                        local command="sacctmgr --noheader show user withassoc where name=$user format=user,account"
                        output=$(cluster-login -- "$command" 2>/dev/null)
                        # the user has no account association yet
                        if [ "$output" = "" ]
                        then 
                                # create a new user and associate to an account
                                command="sacctmgr create user name=$user account=$account defaultaccount=$default"
                        # the user has already an account association
                        else
                                echo "slurm account(s): $(echo "$output" | tr -s ' ' | cut -d' ' -f3 | tr "\n" ' ')"
                                # add a user to another account
                                command="sacctmgr add user account=$account names=$user"
                        fi
                        cluster-login -- "$command"
                else
                        _error "User '$user' has no Linux user account"
                fi
        else
                _error "Requires a username"
        fi
}

list() {
        local command="sacctmgr --noheader --parsable2 show user withassoc format=user,account,defaultaccount"
        # if one argument is present
        if [ "$#" -eq 1 ] ; then
                # show a specified user
                command="$command where user=$1"
        fi
        cluster-login -- "$command" \
                | cut -d'|' -f1- --output-delimiter=" " \
                | column --table --table-columns "User,Account,Default"

}

default() {
        if [ "$#" -eq 2 ]
        then
                local command="sacctmgr modify user name=$1 set defaultaccount=$2"
                cluster-login -- "$command"
        else
                _error "Requires a user and the default account to configured!"
        fi
}

# use a default sub-command unless specified
_command="${1:-help}"
test "$#" -eq 0 || shift
# evaluate sub-commands
case "$_command" in
        add)
                add $@
                ;;
        default)
                default $@
                ;;
        list)
                list $@
                ;;
        *)
                echo "$HELP" 
                exit 1
                ;;
esac

exit 0


