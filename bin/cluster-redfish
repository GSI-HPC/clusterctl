# ensures that if any command in a set of piped commands failed, the overall
# exit status is the status of the failed command
set -o pipefail

VERSION=0.3

# Filename of this script
SCRIPT=${0##*/}

# Help text for this script
HELP=\
"usage: $SCRIPT [-h] [--version] [arg]

Interact with a server BMC using RedFish…

- Either using https://github.com/DMTF/Redfish-Tacklebox
  Install with \`pip install redfish_utilities -U\`
- Or by sending HTTP requests to the Redfish REST API

All commands require environment variables to work…

- BMC_PASSWORD to set the BMC user password
- BMC_USER defaults to 'admin' if not set
- CLUSTER_NODES ot define a nodeset or use option --nodeset

Positional arguments:

  command <args>
   Run a TackleBox command on a nodeset. 

  httpget|get <path> <json_select>
    Send an HTTP GET to the Redfish REST API.

  httppost|post <path> <json>
    Send a HTTP POST to the Redfish REST API.

  power <subcommand>
    Defaults to the 'status' subcommand.
    List of supported subcommands:
      status     Current power state
      on         Power on
      off        Non-graceful power off
      shutdown   Graceful power off
      reset      Non-graceful reset
      reboot     Graceful restart
      cycle      Power removal & restore
      fullcycle  Like above + Remove utility lines

Optional arguments:

  -d, --debug             Enable verbose output
  -h, --help              Show this help message
  -n, --nodeset <nodes>   Specify a nodeset
  --version               Program version number

Environment variables:

  BMC_USER                User name for the BMC
  BMC_PASSWORD            Password for the BMC user
  CLUSTER_NODES           Define a nodeset to work with
"

_DEBUG=${_DEBUG:-false}
_debug() {
        if [ "$_DEBUG" = "true" ]; then
                echo 1>&2 "$SCRIPT debug -- $@"
        fi
}

_error() {
        echo 1>&2 "$SCRIPT error -- $@"
	exit 1
}

_error_cluster_nodes() {
        _error "Set the environment variable CLUSTER_NODES or use command-line option -n/--nodeset!"
}

_error_bmc_password() {
        _error "Set the environment variable BMC_PASSWORD for the $BMC_USER!"
}

##
# Complete the naming convention for the BMCs from a node name
#
bmc-name() {
        cluster-node-fqdn --bmc "${1:?Node name argrument required}"
}

##
# Resolve the IP-address of a BMC
#
bmc-ip() {
        local nodes=${1:?Nodeset argument required}
        local bmcs=$(bmc-name $nodes)
        local node=
        # iterate over all nodes
        for node in $(nodeset -e $bmcs)
        do
                if host $node >/dev/null
                then
                        if [ "$verbose" = "true" ]
                        then
                                host $node | cut -d' ' -f1,4
                        else
                                host $node | cut -d' ' -f4
                        fi
                else
                        _error "$node has no DNS response"
                fi
        done
}


###############################################################################
# HTTP GET to the RedFish REST API
#
redfish_httpget() {

        # enforce cluster nodes
        [ -n "$cluster_nodes" ] || _error_cluster_nodes
        # expand the cluster nodes for later iteration
        cluster_nodes=$(nodeset -e $cluster_nodes)
        _debug "Nodeset: $cluster_nodes"

        # enforce a BMC password
        [ -n "$bmc_password" ] || _error_bmc_password

        # path to append to the query URL (can be empty)
        local path=${1:-''}
        # selection for the jq command
        local select=${2:-'.'}

        # iterate over the nodeset
        for node in $cluster_nodes
        do
                # get the BMC name
                node=$(bmc-name $node)

                local exec="curl -u "$bmc_user:$bmc_password" -k -s -X GET https://${node}/redfish/v1/$path"
                _debug "Execute: $exec"
                test "$verbose" = "true" && echo "$node: "
                eval $exec | jq "$select"
        done 
}

redfish_httppost() {
        # enforce cluster nodes
        [ -n "$cluster_nodes" ] || _error_cluster_nodes
        # expand the cluster nodes for later iteration
        cluster_nodes=$(nodeset -e $cluster_nodes)
        _debug "Nodeset: $cluster_nodes"

        # enforce a BMC password
        [ -n "$bmc_password" ] || _error_bmc_password

        # path to append to the query URL (can be empty)
        local path=${1:-''}
        local content="-d '$2'"
        local user="-u '$bmc_user:$bmc_password'"
        local post="-H 'Content-Type: application/json' -X POST"

        # iterate over the nodeset
        for node in $cluster_nodes
        do
                # get the BMC name
                node=$(bmc-name $node)

                local exec="curl -k -s $user $post $content https://${node}/redfish/v1/$path"
                _debug "Execute: $exec"
                test "$verbose" = "true" && echo "$node: "
                eval $exec 
        done 
}

redfish_command() {

        # redfish command to execute ...for example sys_inverntory
        local command=rf_${1}.py
        shift

        # enforce cluster nodes
        [ -n "$cluster_nodes" ] || _error_cluster_nodes
        # expand the cluster nodes for later iteration
        cluster_nodes=$(nodeset -e $cluster_nodes)
        _debug "Nodeset: $cluster_nodes"

        # enforce a BMC password
        [ -n "$bmc_password" ] || _error_bmc_password

        # iterate over the nodeset
        for node in $cluster_nodes
        do
                # get the BMC name
                node=$(bmc-name $node)
                # list or options to the redfish command
                local options="--user '$bmc_user' --password '$bmc_password' -r https://$node"
        
                # assamble the command to execute
                local exec="$command $options $@"
                _debug "Execute: $exec"

                # execute the command
                test "$verbose" = "true" && echo "$node: "
                eval $exec
        done
}

###############################################################################
# Perform a power/reset operation of a system
#
# Action      | ResetType            | Description
# ------------|----------------------|-------------
# on          | on                   | Turn on
# off         | ForceOff             | Non-graceful power off
# shutdown    | GracefullShutdown    | Graceful power off
# reset       | ForceRestart         | Non-graceful reset
# reboot      | GracefulRestart      | Graceful restart
# cycle       | PowerCycle           | Power removal & restore
# fullcycle   | FullPowerCycle       | Like above + Remove utility lines
#
redfish_power() {


        # set the default power command
        local type=${1:-status}

        case "$type" in
        status)
                verbose=true
                redfish_httpget 'Systems/1' .PowerState | paste -d " "  - - | tr -d '"'
                return
                ;;
        on) type=On ;;
        off) type=ForceOff ;;
        shutdown) type=GracefullShutdown ;;
        reset) type=ForceRestart ;;
        reboot) type=GracefulRestart ;;
        cycle) type=PowerCycle ;;
        fullcycle) type=FullPowerCycle ;;
        *)
                _error "Power command $command not supported"
                ;;
        esac

        # enforce cluster nodes
        [ -n "$cluster_nodes" ] || _error_cluster_nodes

        # enforce a BMC password
        [ -n "$bmc_password" ] || _error_bmc_password

        # expand the cluster nodes for later iteration
        cluster_nodes=$(nodeset -e $cluster_nodes)
        _debug "Nodeset: $cluster_nodes"

        # iterate over the nodeset
        for node in $cluster_nodes
        do
                # get the BMC name
                node=$(bmc-name $node)
                # list or options to the redfish command
                local options="--user $bmc_user --password '$bmc_password' -r https://$node"
        
                # assamble the command to execute
                local exec="rf_power_reset.py $options --info --type $type"
                _debug "Execute: $exec"

                # execute the command
                echo -n "$node: "
                eval $exec | tail -n1 | cut -d':' -f2
        done
}



verbose=false
# read the BMC service module configuration
bmc_user=${BMC_USER:-${CLUSTER_BMC_USER:-admin}}
bmc_password=${BMC_PASSWORD}
# read a nodeset if defined
cluster_nodes=$CLUSTER_NODES

# Parse the command line options
ARGS=$(getopt -o dhn:v -l "debug,help,nodeset:,version,verbose" -- "$@")
eval set -- "$ARGS"
while true; do
        case "$1" in
        -d|--debug)
                _DEBUG=true
                shift
                ;;
        -h|--help)
                echo "$HELP"
                exit 0
                ;;
        -n|--nodeset)
                shift
                cluster_nodes=$1
                shift
                ;;
        -v|--verbose)
                shift
                verbose=true
                ;;
        --version)
                echo $VERSION
                exit 0
                ;;
        --)
                shift
                break 
                ;;
        *) 
                break 
                ;;
        esac
done

# check dependencies...
for cmd in \
        cluster-node-fqdn \
        curl \
        jq \
        paste \
        sed \
        rf_power_reset.py
do
        command -v $cmd &>/dev/null || _error "$cmd command not in \$PATH"
done

### HERE COME THE APPLICATION FUNCTIONS

# Require at least one sub-command
if (( $# >= 1 ))
then
        _command=$1 ; shift
else
        _error "Required sub-command ...use --help option"
fi

case "$_command" in 

# internal commands …eventually called for debugging
        bmc-name|bc)
                bmc-name "$@"
                ;;
        bmc-ip|bi)
                bmc-ip "$@"
                ;;
        httpget|get)
                redfish_httpget "$@"
                ;;
        httppost|post)
                redfish_httppost "$@"
                ;;
        command)
                redfish_command "$@"
                ;;        

# commands which should be invoked by users
        power)
                redfish_power "$@"
                ;;
        *)
                echo "$HELP" 
                exit 1
                ;;
esac

exit 0


