# script exits on the first unset variable encountered
set -u    # nounset
# script stops on first command failure
#set -e    # errexit
# ensures that if any command in a set of piped commands failed, the overall
# exit status is the status of the failed command
#set -o pipefail

_DEBUG=${_DEBUG:-false}
function _debug() {
        if [ "$_DEBUG" = "true" ]; then
                echo 1>&2 "$SCRIPT debug -- $@"
        fi
}

function _error() {
        echo 1>&2 "$SCRIPT error: $@"
	exit 1
}

VERSION=0.3

##
# Read environment variables, and set defaults
#

# same user local user account
cluster_user=${CLUSTER_LOGIN_USER:-${USER}_adm}
cluster_node=${CLUSTER_LOGIN_NODE:-${CLUSTER_HOST_LOGIN:-}}
cluster_dns=${CLUSTER_DNS:-${CLUSTER_HOST_DNS:-}}

# target nodes
cluster_mgmt_gateway=${CLUSTER_MGMT_GATEWAY:-${CLUSTER_HOST_MGMT_GATEWAY:-}}
cluster_mgmt_gateway_user=${CLUSTER_MGMT_GATEWAY_USER:-$USER}
cluster_ifs_node=${CLUSTER_IFS_NODE:-${CLUSTER_HOST_IFS:-}}
cluster_mirror=${CLUSTER_MIRROR:-${CLUSTER_HOST_MIRROR:-}}
cluster_install=${CLUSTER_BOOT:-${CLUSTER_HOST_INSTALL:-}}
cluster_workload_manager=${CLUSTER_WORKLOAD_MANAGER:-''}
cluster_database=${CLUSTER_DATABASE:-''}

# collects a list of additional ssh options
cluster_ssh_options=${CLUSTER_LOGIN_SSH_OPTIONS:-''}
cluster_ssh_proxy_jump=${CLUSTER_LOGIN_SSH_PROXY_JUMP:-${CLUSTER_HOST_SSH_PROXY:-}}
cluster_ssh_known_hosts=${CLUSTER_KNOWN_HOSTS_FILE:-${CLUSTER_LOGIN_SSH_KNOWN_HOSTS:-$CLUSTER_TOOLS_PATH/site-config/ssh-known-hosts}}

# respect the SINGULARITY_CONTAINER from the environment if set by user
SINGULARITY_CONTAINER=${SINGULARITY_CONTAINER:-''}
APPTAINER_CONTAINER=${APPTAINER_CONTAINER:-''}

# boundaries for a connection attempt...
cluster_connection_timeout=${CLUSTER_CONNECTION_TIMEOUT:-3}
cluster_connection_attempts=${CLUSTER_CONNECTION_ATTEMPTS:-2}

# Filename of this script
SCRIPT=${0##*/}

# Help text for this script
HELP=\
"Usage: $SCRIPT [<options>] [-- <command_to_execute>]

Access a cluster login node or the management network gateway for administrative purposes.
If the node name is a DNS alias login will be iterated over all available nodes 
until success.

Pre-defined target nodes:

  -b, --boot, --install         Root login \$CLUSTER_INSTALL=$cluster_install
                                  ...ssh-agent forwarding enabled by default
  -i, --mgmt                    User login \$CLUSTER_MGMT_GATEWAY=$cluster_mgmt_gateway
                                  ...defaults to \$CLUSTER_MGMT_GATEWAY_USER=$cluster_mgmt_gateway_user
                                  ...ssh-agent forwarding enabled by default
  -m, --mirror                  Root login \$CLUSTER_MIRROR=$cluster_mirror
                                  ...ssh-agent forwarding enabled by default
  -n, --node <node>             User login \$CLUSTER_LOGIN_NODE=$cluster_node
                                  ...defaults to \$CLUSTER_LOGIN_USER=$cluster_user
                                  ...do not use a nodeset!
  -s, --ifs                     User login \$CLUSTER_IFS_NODE=$cluster_ifs_node
                                  ...defaults to \$CLUSTER_LOGIN_USER=$cluster_user
                                  ...ssh-agent forwarding enabled by default

  Service nodes for the individual clusters...

  -d, --db                      Root login \$CLUSTER_DATABASE=$cluster_database
  -w, --wlm                     Root login \$CLUSTER_WORKLOAD_MANAGER=$cluster_workload_manager
 
Proxy & VPN configuration:

  -j                            Enable SSH proxy jump if no VPN is available
                                  ...defaults to \$CLUSTER_LOGIN_SSH_PROXY_JUMP=$cluster_ssh_proxy_jump
                                  ...defaults to \$CLUSTER_VPN_CHECK=false
  -J, --jump <node>             Mimics the corresponding SSH proxy jump option.

Login user configuration, defaults to \$CLUSTER_LOGIN_USER=$cluster_user

  -r, --root                    Login as root instead of a common user
  -u, --user <user>             Specify user account name for remote login
  -U                            Inherit the current user \$USER=$USER for login

Options:

  -a                            Export APPTAINER_CONTAINER=none
  -A                            Enable ssh-agent forwarding.
  -C, --config                  Print CLUSTER_* environment variables
  -D, --debug                   Enable debug output
      --ssh-debug               Enable SSH debug output
  -h, --help                    Show this help message
  -K, --no-key-check            Disable host key checking.
      --known-hosts <path>      Provide the path to the SSH known_hosts file
  -t                            Force pseudo-terminal allocation
  -T                            Print a timer stamp '%Z %Y/%m/%d %H:%M' before the login. 
      --version                 Print this programs version number
  -X                            Enables X11 forwarding over SSH.

Environment variables:

  CLUSTER_LOGIN_NODE             Set login node to use
  CLUSTER_LOGIN_USER             Set user account for login
  CLUSTER_LOGIN_SSH_OPTIONS      Additional options to the SSH command
  CLUSTER_LOGIN_SSH_PROXY_JUMP   Default node for SSH proxy jump
  CLUSTER_LOGIN_SSH_KNOWN_HOSTS  Provide the path to the SSH known_hosts file
  CLUSTER_DNS                    DNS server to query for a list of pool nodes
  CLUSTER_DATABASE               Node hosting the cluster database 
  CLUSTER_WORKLOAD_MANAGER       Node hosting the cluster workload management
  CLUSTER_MIRROR                 Node hosting the cluster package repositories
  CLUSTER_INSTALL                Node hosting the cluster boot & install service
  CLUSTER_MGMT_GATEWAY           Set login node for the management network gateway
  CLUSTER_MGMT_GATEWAY_USER      Set login user for the management network gateway
  CLUSTER_IFS_NODE               Set login node for the cluster infrastructures services
  CLUSTER_CONNECTION_TIMEOUT     Timeout for SSH connections (defaults to 3)
  CLUSTER_CONNECTION_ATTEMPTS    Number of connection attempts (defaults to 1)"



# Parse the command line options
ARGS=$(getopt -o aAbCdDhijJ:KLrstTn:mu:UwX -l "boot,config,db,debug,ssh-debug,help,install,jump:,known-hosts:,no-key-check,no-test-login,mirror,node:,mgmt,ifs,root,user:,wlm,version" -- "$@")
eval set -- "$ARGS"
while true; do
        case "$1" in
        -a)
                shift
                export APPTAINER_CONTAINER=none
                ;;
        -A)
                shift
                cluster_ssh_options="$cluster_ssh_options -A"
                ;;
        -b|--boot|--install)
                shift
                # overwrite the connection parameters for the boot & install server
                cluster_node=$cluster_install
                cluster_user=root
                # forward ssh-agent by default
                cluster_ssh_options="$cluster_ssh_options -A"
                ;;
        -C|--config)
                env | grep ^CLUSTER_
                exit 0
                ;;
        -d|--db)
                shift
                if [ -n "$cluster_database" ]
                then
                        cluster_user=root
                        cluster_node=$cluster_database
                else
                        _error "\$CLUSTER_DATABASE environment variable not set!"
                fi
                ;;
        -D|--debug)
                shift
                export _DEBUG=true
                ;;
        --ssh-debug)
                shift
                cluster_ssh_options="$cluster_ssh_options -vvv"
                ;;
        -h|--help)
                echo "$HELP"
                exit 0
                ;;
        -i|--mgmt)
                shift
                # overwrite the connection parameters for the management network gateway
                cluster_node=$cluster_mgmt_gateway
                cluster_user=$cluster_mgmt_gateway_user
                # forward ssh-agent by default
                cluster_ssh_options="$cluster_ssh_options -A"
                ;;
        -s|--ifs)
                shift
                cluster_node=$cluster_ifs_node
                cluster_ssh_options="$cluster_ssh_options -A"
                ;;
        -j)
                shift
                cluster_ssh_options="$cluster_ssh_options -J $cluster_ssh_proxy_jump"
                # implies disable of the VPN check
                ;;
        -J|--jump)
                shift
                cluster_ssh_options="$cluster_ssh_options -J $1"
                # implies disable of the VPN check
                shift
                ;;
        -K|--no-key-check)
                shift
                cluster_ssh_options="$cluster_ssh_options -o UserKnownHostsFile=/dev/null -o StrictHostKeyChecking=no -q"
                ;;
        --known-hosts)
                shift
                cluster_ssh_options="$cluster_ssh_options -o UserKnownHostsFile=$1 -o StrictHostKeyChecking=yes -q"
                shift
                ;;
        -m|--mirror)
                shift
                cluster_user=root
                cluster_node=$cluster_mirror
                cluster_ssh_options="$cluster_ssh_options -A"
                ;;
        -n|--node)
                shift
                cluster_node=$1
                shift
                ;;
        -r|--root)
                shift
                cluster_user=root
                ;;
        -t)
                shift
                cluster_ssh_options="$cluster_ssh_options -t"
                ;;
        -T)
                shift
                date '+%Z %Y/%m/%d %H:%M'
                ;;
        -u|--user)
                shift
                cluster_user=$1
                shift
                ;;
        -U)
                shift
                cluster_user=$USER
                # do not check host IP by default
                cluster_ssh_options="$cluster_ssh_options -o CheckHostIP=no"
                ;;
        --version)
                echo $VERSION
                exit 0
                ;;
        -w|--wlm)
                shift
                if [ -n "$cluster_workload_manager" ]
                then
                        cluster_user=root
                        cluster_node=$cluster_workload_manager
                else
                        _error "\$CLUSTER_WORKLOAD_MANAGER environment variable not set!"
                fi
                cluster_ssh_options="$cluster_ssh_options -A"
                ;;
        -X)
                shift
                cluster_ssh_options="$cluster_ssh_options -X"
                ;;
        --)
                shift
                break 
                ;;
        *) 
                break 
                ;;
        esac
done

if [[ ! "$cluster_node" == *"."* ]]
then
        cluster_node=$cluster_node.${CLUSTER_DOMAIN_HPC:-}
else
        domain=${cluster_node#*.}
        if ! [[ "$domain" == ${CLUSTER_DOMAIN_HPC:-} || "$domain" == ${CLUSTER_DOMAIN_MGMT_HPC:-} || "$domain" == ${CLUSTER_DOMAIN_SITE:-} ]]
        then
                echo "\"$domain\" is not a valid domain."
        fi
fi

##
# Check dependency programs
#
for cmd in \
        cut \
        eval \
        grep \
        netcat \
        sed \
        sort \
        tac \
        tr \
        ssh
do
        command -v $cmd &>/dev/null || _error "$cmd program missing"
done


# check if SINGULARITY_CONTAINER is not empty
if [ -n "$SINGULARITY_CONTAINER" ]
then
        # enable propagation of the SINGULARITY_CONTAINER environment variable
        cluster_ssh_options="$cluster_ssh_options -o SendEnv=SINGULARITY_CONTAINER"
        _debug "Propagate SINGULARITY_CONTAINER=$SINGULARITY_CONTAINER with the SSH connection"
fi

# check if APPTAINER_CONTAINER is not empty
if [ -n "$APPTAINER_CONTAINER" ]
then
        # enable propagation of the SINGULARITY_CONTAINER environment variable
        cluster_ssh_options="$cluster_ssh_options -o SendEnv=APPTAINER_CONTAINER"
        _debug "Propagate APPTAINER_CONTAINER=$APPTAINER_CONTAINER with the SSH connection"
fi

cluster_ssh_options="$cluster_ssh_options -o UserKnownHostsFile=$cluster_ssh_known_hosts -o StrictHostKeyChecking=yes"

# read all other command-line arguments, trim white space
command_to_execute=$(echo $@ | tr -s ' ')


# unless command line arguments are present
if [[ "$#" -eq 0 ]]
then
        # login for an interactive session
        command="ssh $cluster_ssh_options $cluster_user@$cluster_node"
else
        # escape single quotes
        command_to_execute=$(echo $command_to_execute | sed "s/'/\\\\'/g")
        # encapsulate the command into single quote
        command="ssh $cluster_ssh_options $cluster_user@$cluster_node -- $'$command_to_execute'"
fi
_debug "Evaluate command: $command"
# run the ssh login command
eval $command
# after successful login, return exit code of command
exit $?


# unsuccessful login
exit 1
