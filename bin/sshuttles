# script exits on the first unset variable encountered
set -u    # nounset
# script stops on first command failure
set -e    # errexit
# ensures that if any command in a set of piped commands failed, the overall
# exit status is the status of the failed command
set -o pipefail

VERSION=0.17

# Configuration directories (built at runtime)
config_dirs=()

# Filename of this script
SCRIPT=${0##*/}

# Help text for this script
HELP=\
"usage: $SCRIPT [-h] [--version] [arg]

This script uses Sshuttle configuration to manage multiple connections.
Configuration files (.conf) are searched in the following order:

  1. \$SSHUTTLE_CONFIGS     Single directory specified via environment variable
  2. ~/.sshuttle           User-level default directory
  3. /etc/sshuttle.d       System-wide default directory

When the same configuration name exists in multiple directories,
the highest-priority location wins.

positional arguments:
  list                 List short names for all available configurations
  start <name>         Start a Sshuttle connection by specifying the short
                       name of the configuration file
  status               List all established Sshuttle connections
  stop <name>          Stop a Sshuttle connection by specifying the short
                       name of a connection file

optional arguments:
  -d, --debug          enable verbose output
  -h, --help           show this help message
  --version            program version number

Environment variables

  SSHUTTLE_CONFIGS     Override with a single config directory path.
                       Takes precedence over ~/.sshuttle and /etc/sshuttle.d.
"

_DEBUG=${_DEBUG:-false}
_debug() {
        if [ "$_DEBUG" = "true" ]; then
                echo 1>&2 "Debug: $@"
        fi
}

_error() {
        echo 1>&2 "Error: $@"
	exit 1
}

# Build an ordered array of valid config directories.
# Priority: SSHUTTLE_CONFIGS env var > ~/.sshuttle > /etc/sshuttle.d
_build_config_dirs() {
        config_dirs=()
        if [[ -n "${SSHUTTLE_CONFIGS:-}" ]]; then
                local expanded="${SSHUTTLE_CONFIGS/#\~/$HOME}"
                if [[ -d "$expanded" ]]; then
                        config_dirs+=("$expanded")
                fi
        fi
        local user_dir="$HOME/.sshuttle"
        if [[ -d "$user_dir" ]]; then
                config_dirs+=("$user_dir")
        fi
        local sys_dir="/etc/sshuttle.d"
        if [[ -d "$sys_dir" ]]; then
                config_dirs+=("$sys_dir")
        fi
}

# Find a .conf file by name across priority-ordered config dirs.
# Sets _found_config_path on success; warns about duplicates in debug mode.
_found_config_path=""
_find_config() {
        local name="$1"
        _found_config_path=""
        if [[ ${#config_dirs[@]} -eq 0 ]]; then
                return 1
        fi
        local count=0
        for dir in "${config_dirs[@]}"; do
                local candidate="$dir/${name}.conf"
                if [[ -f "$candidate" ]]; then
                        count=$((count + 1))
                        if [[ $count -eq 1 ]]; then
                                _found_config_path="$candidate"
                        else
                                _debug "Config \"${name}.conf\" also found in $candidate (shadowed by $_found_config_path)"
                        fi
                fi
        done
        if [[ -z "$_found_config_path" ]]; then
                return 1
        fi
        return 0
}

# Expand ${NAME} and ${NAME:-default} references from the environment.
# Sets _expanded to the result.
_expanded=""
_expand_vars() {
        local rest="$1" name
        local re='^([^$]*)\$\{([A-Za-z_][A-Za-z0-9_]*)(:-([^}]*))?\}(.*)$'
        _expanded=""
        while [[ $rest =~ $re ]]; do
                name=${BASH_REMATCH[2]}
                _expanded+=${BASH_REMATCH[1]}
                if [[ -n "${!name:-}" ]]; then
                        _expanded+=${!name}
                else
                        _debug "Variable $name is unset or empty"
                        _expanded+=${BASH_REMATCH[4]}
                fi
                rest=${BASH_REMATCH[5]}
        done
        _expanded+=$rest
}

# Read a configuration file (one argument per line, like `sshuttle @file`)
# into config_args, expanding variable references. Arguments expanding to an
# empty string are dropped, together with a preceding exclude option.
config_args=()
_read_config_args() {
        local file="$1" line
        config_args=()
        while IFS= read -r line || [[ -n "$line" ]]; do
                line="${line#"${line%%[![:space:]]*}"}"
                line="${line%"${line##*[![:space:]]}"}"
                if [[ -z "$line" || "$line" == \#* ]]; then
                        continue
                fi
                # sshuttle strips quotes enclosing the whole line
                if [[ ${#line} -ge 2 && ( "$line" == \'*\' || "$line" == \"*\" ) ]]; then
                        line=${line:1:${#line}-2}
                fi
                _expand_vars "$line"
                if [[ -n "$_expanded" ]]; then
                        config_args+=("$_expanded")
                        continue
                fi
                if [[ ${#config_args[@]} -eq 0 ]]; then
                        continue
                fi
                case "${config_args[-1]}" in
                -x|--exclude)
                        unset 'config_args[-1]'
                        ;;
                -r|--remote)
                        _error "$file: remote host \"$line\" expands to an empty string"
                        ;;
                esac
        done < "$file"
}

# Parse the command line options
ARGS=$(getopt -o dh -l "debug,help,version" -- "$@")
eval set -- "$ARGS"
while true; do
        case "$1" in
        -d|--debug)
                _DEBUG=true
                shift
                ;;
        -h|--help)
                echo "$HELP"
                exit 0
                ;;
        --version)
                echo $VERSION
                exit 0
                ;;
        --)
                shift
                break 
                ;;
        *) 
                break 
                ;;
        esac
done

# check dependencies...
for cmd in \
        sshuttle
do
        command -v $cmd &>/dev/null || _error "$cmd command not in \$PATH"
done

# Build config directory list and trace it
_build_config_dirs
if [[ ${#config_dirs[@]} -gt 0 ]]; then
        _debug "Config search directories (${#config_dirs[@]} found): ${config_dirs[*]}"
else
        _debug "No configuration directories found"
fi

list() {
        if [[ ${#config_dirs[@]} -eq 0 ]]; then
                _error "No configuration directories available"
        fi
        declare -A seen
        local found=false
        for dir in "${config_dirs[@]}"; do
                for file in "$dir"/*.conf; do
                        [[ -e "$file" ]] || continue
                        found=true
                        local base=$(basename "$file" .conf)
                        if [[ -z "${seen[$base]:-}" ]]; then
                                echo "$base"
                                seen["$base"]=1
                        fi
                done
        done
        if [[ "$found" = false ]]; then
                _error "No configuration files found in any config directory"
        fi
}

start() {
        if [ $# -eq 0 ]
        then
                _error "Argument to start a connection missing"
        else
                config_name=$1
                if ! _find_config "$config_name"
                then
                        _error "Missing sshuttle configuration file \"${config_name}.conf\" in any config directory"
                fi
                _debug "Using config: $_found_config_path"

                pid_file=/tmp/$USER-sshuttle-$config_name.pid

                # if a process ID is available
                if test -f $pid_file
                then
                        echo "$pid_file exists"
                        status
                        exit 0
                fi

                _read_config_args "$_found_config_path"
                _debug "sshuttle ${config_args[*]} --pidfile=$pid_file"

                # if sshuttle can setup a connection
                if sshuttle "${config_args[@]}" --pidfile=$pid_file
                then
                        reset
                        echo "Sshuttle started ($pid_file)"
                        status
                        exit 0
                else
                         _error "Sshuttle returns non zero exit code"
                fi
        fi
}

status() {
        echo "Sshuttle connections..."
        for pid_file in $(ls -1 /tmp/$USER-sshuttle-*.pid 2>/dev/null)
        do
                pgrep --list-full --pidfile $pid_file
        done
}

stop() {
        if [ $# -eq 0 ]
        then
                _error "Specify a Sshuttle connection to stop"
        else
                config_name=$1
                pid_file=/tmp/$USER-sshuttle-$config_name.pid
                test -f $pid_file || _error "$pid_file is missing"
                pkill --pidfile $pid_file --signal TERM
        fi
}

_command=${1:-status}
case "$_command" in 
        list)
                list
                ;;
        restart)
                stop "$2"
                start "$2"
                ;;
        start)
                start "$2"
                ;;
        status)
                status
                ;;
        stop)
                stop "$2"
                ;;
        *)
                echo "$HELP" 
                exit 1
                ;;
esac

exit 0


